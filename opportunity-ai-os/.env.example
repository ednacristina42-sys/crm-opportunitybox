# Copie este ficheiro para .env (ou .env.local) e preencha com os valores reais.
# NUNCA commitar o .env com valores reais — só os NOMES ficam aqui.

# URL do projeto Supabase (Settings > API no painel Supabase)
VITE_SUPABASE_URL=

# Anon/public key do projeto Supabase (Settings > API no painel Supabase)
# Nunca colocar aqui a service_role key — essa nunca deve chegar ao frontend.
VITE_SUPABASE_ANON_KEY=

# Ambiente atual: local | staging | production
VITE_APP_ENV=local
